#!/usr/bin/env node
import { readFileSync, appendFileSync, existsSync } from 'node:fs'
import { execFileSync } from 'node:child_process'
import path from 'node:path'

const argv = process.argv.slice(2)
const fixtureDir = process.env.EVAL_FIXTURE
if (!fixtureDir) {
  process.stderr.write('gh stub: EVAL_FIXTURE not set\n')
  process.exit(2)
}

appendFileSync(path.join(fixtureDir, 'gh-calls.log'), JSON.stringify(argv) + '\n')

const fixture = JSON.parse(readFileSync(path.join(fixtureDir, 'fixture.json'), 'utf8'))

function jsonFields(args) {
  const i = args.indexOf('--json')
  return i === -1 ? [] : args[i + 1].split(',')
}
function pick(obj, fields) {
  const out = {}
  for (const f of fields) out[f] = obj[f]
  return out
}

const [cmd, sub, ...rest] = argv

if (cmd === 'pr' && sub === 'view') {
  process.stdout.write(JSON.stringify(pick(fixture, jsonFields(rest))))
  process.exit(0)
}

if (cmd === 'repo' && sub === 'view') {
  process.stdout.write(JSON.stringify({ nameWithOwner: fixture.repo }))
  process.exit(0)
}

if (cmd === 'issue' && sub === 'view') {
  const number = Number(rest[0])
  const issue = (fixture.issues || []).find(i => i.number === number)
  if (!issue) {
    process.stderr.write(`gh stub: no fixture issue #${number}\n`)
    process.exit(1)
  }
  process.stdout.write(JSON.stringify(pick(issue, jsonFields(rest))))
  process.exit(0)
}

if (cmd === 'pr' && sub === 'diff') {
  const gitArgs = ['diff']
  if (rest.includes('--stat')) gitArgs.push('--stat')
  if (rest.includes('--name-only')) gitArgs.push('--name-only')
  process.stdout.write(execFileSync('git', gitArgs, { cwd: path.join(fixtureDir, 'work'), encoding: 'utf8' }))
  process.exit(0)
}

if (cmd === 'api') {
  const m = /^\/advisories\/(.+)$/.exec(sub || '')
  if (m) {
    const advPath = path.join(fixture.caseDir, 'advisories', `${m[1]}.json`)
    if (existsSync(advPath)) {
      process.stdout.write(readFileSync(advPath, 'utf8'))
      process.exit(0)
    }
    process.stderr.write(`gh stub: no advisory fixture for ${m[1]}\n`)
    process.exit(1)
  }
}

process.stderr.write(`gh stub: unsupported: ${JSON.stringify(argv)}\n`)
process.exit(2)
